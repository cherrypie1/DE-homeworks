        <mxCell id="Vn-OcyyjwG1SDEmhwPBz-264" value="2023-01-02" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=16;" parent="Vn-OcyyjwG1SDEmhwPBz-256" vertex="1">
